@echo off
chcp 65001 > nul
title تسجيل الدخول في Firebase وتفعيل قواعد الأمان
cls
echo ======================================================================
echo    تسجيل الدخول في حساب Firebase وتفعيل قواعد الأمان
echo    مشروع كنيسة مارمينا العجايبي (k-ilo-eb1f2)
echo ======================================================================
echo.
echo  [1/2] سيفتح المتصفح الآن لتسجيل الدخول بحساب Google المرتبط بـ Firebase...
echo  (يرجى اختيار حسابك والموافقة على الأذونات في المتصفح)
echo.
call npx -y firebase-tools@latest login
echo.
echo ======================================================================
echo  [2/2] جاري نشر قواعد أمان Firestore الآن (allow read, write: if true)...
echo ======================================================================
echo.
call npx -y firebase-tools@latest deploy --only firestore:rules --project k-ilo-eb1f2
echo.
echo ======================================================================
echo   🎉 تم الانتهاء بنجاح! السحابة جاهزة الآن لحفظ كل البيانات من كل الأجهزة.
echo ======================================================================
echo.
pause
